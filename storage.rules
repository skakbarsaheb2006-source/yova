rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // YOVA Collections - Product Images Storage Security Rules
    // Public read access for customers to view jewellery product photos
    // Only authenticated admins can upload, update, or delete product images
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
