rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sk.akbarsaheb2006@gmail.com';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
          'id', 'date', 'createdAt', 'customer', 'items', 'subtotal', 'shipping',
          'total', 'paymentMethod', 'paymentStatus', 'orderStatus', 'notes'
        ])
        && request.resource.data.id == orderId
        && request.resource.data.createdAt == request.time
        && request.resource.data.customer is map
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.orderStatus == 'Pending';
      allow read, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow create: if request.resource.data.keys().hasAll([
          'customerName', 'productName', 'rating', 'reviewText', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'customerName', 'productName', 'rating', 'reviewText', 'status', 'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 60
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.productName.size() <= 100
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.reviewText is string
        && request.resource.data.reviewText.size() > 0
        && request.resource.data.reviewText.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}